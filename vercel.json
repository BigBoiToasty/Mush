{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'nothing to install'",
  "buildCommand": "mkdir -p vercel-out && cp vercel/sw.js vercel-out/sw.js",
  "outputDirectory": "vercel-out",
  "redirects": [
    {
      "source": "/",
      "destination": "https://mush.christopherle.org/",
      "permanent": true
    },
    {
      "source": "/((?!sw\\.js$).+)",
      "destination": "https://mush.christopherle.org/$1",
      "permanent": true
    }
  ]
}
